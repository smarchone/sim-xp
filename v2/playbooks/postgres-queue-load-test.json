          "id": "enq_rate",
          "to": 800,
          "over_s": 10
        },
        {
          "id": "depth",
          "to": 64000,
          "over_s": 30,
          "shape": "linear"
        }
      ],
      "beat": {
        "tone": "bad",
        "hint": "Slow claims hold connections longer, so the pool fills. Inserts can no longer get a connection and start failing. The queue now has 64k jobs behind it and the test has found its limit, but the cause is not load.",
        "focus": [
          "api",
          "db",
          "panel:conns",
          "panel:errors",
          "panel:depth"
        ],
        "notes": [
          {
            "panel": "conns",
            "text": "Pool pinned at 100: slow queries hold connections longer"
          },
          {
            "panel": "errors",
            "text": "Enqueues fail: users would see 503s"
          },
          {
            "panel": "depth",
            "text": "Depth past 20k alert and still climbing"
          }
        ]
      }
    },
    {
      "t": 225,
      "feed": {
        "from": "Ravi · #queue-loadtest",
        "kind": "chat",
        "text": "should we double the workers to drain it? or just bump max_connections?"
      }
