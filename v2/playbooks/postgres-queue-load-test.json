        "id": "e-lg",
        "from": "loadgen",
        "to": "api"
      },
      {
        "id": "e-api",
        "from": "api",
        "to": "db"
      },
      {
        "id": "e-w",
        "from": "db",
        "to": "workers"
      },
      {
        "id": "e-vac",
        "from": "vacuum",
        "to": "db"
      },
      {
        "id": "e-rep",
        "from": "report",
        "to": "db"
      }
    ],
    "layout": {
      "rows": [
        [
          "loadgen",
          "vacuum",
          null
        ],
        [
          "api",
          "db",
          "workers"
        ],
        [
          null,
          "report",
          null
        ]
      ]
    }
  },
  "metrics": [
    {
      "id": "enq_rate",
      "label": "Enqueue rate (accepted)",
      "unit": "jobs/s",
      "start": 200,
      "noise": 0.05
    },
    {
      "id": "done_rate",
      "label": "Completed rate",
      "unit": "jobs/s",
      "start": 200,
      "noise": 0.05
    },
    {
      "id": "depth",
      "label": "Queue depth",
      "unit": "jobs",
      "start": 50,
      "noise": 0.06,
      "normal": [
        0,
        500
      ]
    },
    {
      "id": "deq_p99",
      "label": "Dequeue p99",
      "unit": "ms",
      "start": 4,
      "noise": 0.08,
      "normal": [
        1,
        20
      ]
    },
    {
      "id": "dead_tup",
      "label": "Dead tuples",
      "unit": "k tuples",
      "start": 20,
      "noise": 0.04
    },
    {
      "id": "db_cpu",
      "label": "DB CPU",
      "unit": "%",
      "start": 20,
      "noise": 0.05
    },
    {
      "id": "conns",
      "label": "DB connections in use",
      "unit": "conns",
      "start": 30,
      "noise": 0.04
    },
    {
      "id": "xact_age",
      "label": "Oldest open transaction",
      "unit": "s",
      "start": 1,
      "noise": 0.05
    },
    {
      "id": "table_gb",
      "label": "jobs table size",
      "unit": "GB",
      "start": 1.2,
      "noise": 0
    },
    {
      "id": "errors",
      "label": "Enqueue errors",
      "unit": "err/s",
      "start": 0,
      "noise": 0
    }
  ],
  "dashboard": [
    {
      "id": "flow",
      "title": "Enqueued vs completed",
      "metrics": [
        "enq_rate",
        "done_rate"
      ],
      "why": "Accepted vs finished jobs. When completed falls below enqueued, the queue grows by the difference.",
      "component": "workers"
    },
    {
      "id": "depth",
      "title": "Queue depth",
      "metrics": [
        "depth"
      ],
      "threshold": {
        "value": 20000,
        "label": "alert 20k"
      },
      "why": "Jobs waiting. It grows at enqueued minus completed, so a flat line means the queue keeps up.",
      "component": "db"
    },
    {
      "id": "deq_p99",
      "title": "Dequeue p99",
      "metrics": [
        "deq_p99"
      ],
      "threshold": {
        "value": 200,
        "label": "alert 200 ms"
      },
      "why": "Time to claim a batch. Slow claims cut worker throughput directly.",
      "component": "db"
    },
    {
      "id": "dead_tup",
      "title": "Dead tuples",
      "metrics": [
        "dead_tup"
      ],
      "why": "Deleted rows not yet cleaned. Rising while vacuum runs means something is blocking cleanup.",
      "component": "vacuum"
    },
    {
      "id": "xact_age",
      "title": "Oldest open transaction",
      "metrics": [
        "xact_age"
      ],
      "threshold": {
        "value": 120,
        "label": "alert 2 min"
      },
      "why": "Vacuum cannot remove rows newer than the oldest open transaction. A long one blocks cleanup for everyone.",
      "component": "report"
    },
    {
      "id": "conns",
      "title": "DB connections",
      "metrics": [
        "conns"
      ],
      "max": 120,
      "threshold": {
        "value": 100,
        "label": "pool max 100"
      },
      "why": "Slow queries hold connections longer. At the limit, new requests queue or fail.",
      "component": "db"
    },
    {
      "id": "db_cpu",
      "title": "DB CPU",
      "metrics": [
        "db_cpu"
      ],
      "max": 100,
      "why": "Dead-row scanning burns CPU, but it looks like plain load. It is a symptom, not the cause.",
      "component": "db"
    },
    {
      "id": "errors",
      "title": "Enqueue errors",
      "metrics": [
        "errors"
      ],
      "why": "Producers failing to insert. This is the user-visible failure of the test.",
      "component": "api"
    },
    {
      "id": "table_gb",
      "title": "jobs table size",
      "metrics": [
        "table_gb"
      ],
      "why": "Bloat: the table grows even though few live rows exist, and it will not shrink by itself.",
      "component": "db"
    }
  ],
  "alerts": [
    {
      "id": "depth-high",
      "metric": "depth",
      "op": ">",
      "value": 20000,
      "for_s": 20,
      "severity": "critical",
      "component": "db",
      "summary": "jobs queue depth > 20k"
    },
    {
      "id": "deq-slow",
      "metric": "deq_p99",
      "op": ">",
      "value": 200,
      "for_s": 20,
      "severity": "warning",
      "component": "db",
      "summary": "dequeue p99 > 200 ms"
    },
    {
      "id": "xact-long",
      "metric": "xact_age",
      "op": ">",
      "value": 120,
      "for_s": 20,
      "severity": "warning",
      "component": "report",
      "summary": "open transaction older than 2 min"
    },
    {
      "id": "conns-full",
      "metric": "conns",
      "op": ">",
      "value": 90,
      "for_s": 15,
      "severity": "critical",
      "component": "db",
      "summary": "DB connections > 90 of 100"
    }
  ],
