      "feed": {
        "from": "autovacuum",
        "kind": "log",
        "text": "automatic vacuum of table jobs: tuples: 0 removed, 412310 dead but not yet removable, oldest xmin: 91823",
        "key": true
      },
      "effects": [
        {
          "target": "vacuum",
          "color": "amber",
          "intensity": 0.6,
          "label": "can't remove"
        },
        {
          "target": "db",
          "color": "amber",
          "intensity": 0.5,
          "label": "bloating"
        }
      ],
      "metrics": [
        {
          "id": "conns",
          "to": 100,
          "over_s": 60
        },
        {
          "id": "db_cpu",
          "to": 95,
          "over_s": 40
        }
      ]
    },
    {
      "t": 170,
      "feed": {
        "from": "Ravi · #queue-loadtest",
        "kind": "chat",
        "text": "dequeue p99 is climbing and completed is falling, but nothing changed in the test. CPU is high but no obvious hot query?"
      }
    },
    {
      "t": 175,
      "title": "Dequeues slow to a crawl",
      "effects": [
        {
          "target": "workers",
          "color": "amber",
          "intensity": 0.6,
          "pulse": true,
          "label": "slow claims"
        },
        {
          "target": "db",
          "pulse": true
        },
        {
          "target": "e-w",
          "color": "amber",
          "flow": 0.5
        }
      ],
      "beat": {
        "tone": "bad",
        "hint": "Every claim scans an index full of dead entries to find live rows, and it gets worse as the dead pile grows. Workers wait longer per batch, so completed falls even though the load has not changed.",
        "focus": [
          "db",
          "workers",
          "panel:deq_p99",
          "panel:flow",
          "panel:depth"
        ],
        "notes": [
          {
            "panel": "deq_p99",
            "text": "Claims skip over dead entries: p99 climbs far past normal"
          },
          {
            "panel": "flow",
            "metric": "done_rate",
            "text": "Completed falls while enqueue holds: the queue grows"
          },
          {
            "panel": "dead_tup",
            "text": "Still rising: vacuum is blocked, not slow"
          }
        ]
      }
    },
    {
      "t": 185,
      "feed": {
        "from": "postgres",
        "kind": "log",
        "text": "LOG: duration: 612.4 ms  statement: SELECT id FROM jobs WHERE status = 'ready' ORDER BY id LIMIT 50 FOR UPDATE SKIP LOCKED"
      }
    },
    {
      "t": 210,
      "title": "The wall: pool exhausted",
      "feed": {
        "from": "enqueue-api",
        "kind": "log",
        "text": "ERROR timeout acquiring DB connection after 2000 ms (pool 100/100 in use). Returning 503 to client",
        "key": true
      },
      "effects": [
        {
          "target": "db",
          "color": "red",
          "intensity": 0.8,
          "pulse": true,
          "label": "pool full"
        },
        {
          "target": "api",
          "color": "red",
          "intensity": 0.6,
          "pulse": true,
          "label": "503s"
