      "t": 240,
      "title": "Kill the long transaction",
      "feed": {
        "from": "Dana · terminal",
        "kind": "deploy",
        "text": "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE xact_start < now() - interval '5 min';  → weekly-export killed. Also: more workers would only add connections to an already full pool",
        "key": true
      },
      "effects": [
