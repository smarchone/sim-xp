  {
   "t": 108,
   "title": "Two histories",
   "beat": {
    "hint": "Connectivity is back but the damage is done. East holds a few seconds of writes that never reached West; West has taken new writes since the failover. Each side has data the other lacks, and East apps now pay a cross-country round trip on every write.",
    "focus": [
     "east",
     "west",
     "e-xc",
     "apps",
     "panel:lat",
     "panel:orph"
    ],
    "notes": [
