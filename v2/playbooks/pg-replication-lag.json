    "intensity": 0.2,
    "label": "idle"
   },
   {
    "target": "e-user",
    "flow": 0.5
   },
   {
    "target": "e-write",
    "flow": 0.2,
    "color": "teal"
   },
   {
    "target": "e-read1",
    "flow": 0.5,
    "color": "blue"
   },
   {
    "target": "e-read2",
    "flow": 0.5,
    "color": "blue"
   },
   {
    "target": "e-wal1",
    "flow": 0.2,
    "color": "teal"
   },
