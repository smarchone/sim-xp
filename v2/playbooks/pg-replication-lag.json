   {
    "target": "e-bf",
    "flow": 0
   }
  ]
 },
 "timeline": [
  {
   "t": 3,
   "title": "Meet the system",
   "beat": {
    "focus": [
     "primary",
     "r1",
     "r2",
     "e-wal1",
     "e-wal2"
    ],
    "hint": "Writes go to pg-primary. Reads go to two replicas that replay the primary's WAL (its change log) over async streaming replication. Replay lag is about 30ms, so a read right after a write almost always sees it.",
    "notes": [
     {
      "panel": "lag",
      "text": "Replay lag ~30ms: replicas are effectively current"
     },
     {
      "panel": "wal",
      "text": "Replicas replay WAL as fast as the primary writes it"
     }
    ]
   }
  },
  {
   "t": 15,
   "feed": {
    "from": "profile-api",
    "kind": "log",
    "text": "PATCH /v1/profile user=2291 → pg-primary 200 (6ms); GET → pg-replica-1 200 (2ms)"
   }
  },
  {
   "t": 28,
   "feed": {
    "from": "Priya · #data-eng",
    "kind": "chat",
    "text": "kicking off the users.tz backfill now, 42M rows in 50k batches. should be done by EOD"
   }
  },
  {
   "t": 40,
   "title": "Backfill starts",
   "feed": {
    "from": "backfill_user_tz",
    "kind": "deploy",
    "text": "UPDATE users SET tz = … WHERE id BETWEEN $1 AND $1+50000 (no pause between batches)"
   },
   "effects": [
    {
     "target": "backfill",
     "color": "amber",
     "intensity": 0.6,
     "pulse": true,
     "label": "batch 1/840"
    },
    {
     "target": "e-bf",
     "flow": 1,
     "color": "amber"
    },
    {
     "target": "e-wal1",
     "flow": 0.9,
     "width": 0.8
    },
    {
     "target": "e-wal2",
     "flow": 0.9,
     "width": 0.8
    },
    {
     "target": "primary",
     "color": "amber",
     "intensity": 0.4
    }
   ],
   "metrics": [
    {
     "id": "wal_gen",
     "to": 70,
     "over_s": 8
    },
    {
     "id": "wal_replay",
     "to": 50,
     "over_s": 10
    }
   ]
  },
