{
 "schema": "sim-xp/playbook@2",
 "meta": {
  "id": "pg-replication-lag",
  "title": "Saved, refreshed, reverted: replica lag",
  "story": "A profile service writes to a Postgres primary and serves reads from two streaming replicas. It has worked for years. This afternoon a user renames herself, gets a green 'Saved', hits refresh, and her old name is back.",
  "duration_s": 300,
  "tags": [
   "postgres",
   "replication",
   "read-replicas",
   "consistency"
  ]
 },
 "components": {
  "nodes": [
   {
    "id": "browser",
    "label": "maya's browser",
    "kind": "client"
   },
   {
    "id": "api",
    "label": "profile-api",
    "kind": "service · v2.13"
   },
   {
    "id": "backfill",
    "label": "backfill_user_tz",
    "kind": "batch job"
   },
   {
    "id": "primary",
    "label": "pg-primary",
    "kind": "postgres 16 · primary"
   },
   {
    "id": "r1",
    "label": "pg-replica-1",
    "kind": "hot standby · async"
   },
   {
    "id": "r2",
    "label": "pg-replica-2",
    "kind": "hot standby · async"
   }
  ],
  "edges": [
   {
    "id": "e-user",
    "from": "browser",
    "to": "api"
   },
   {
    "id": "e-write",
    "from": "api",
    "to": "primary"
   },
   {
    "id": "e-bf",
    "from": "backfill",
    "to": "primary"
   },
   {
    "id": "e-read1",
    "from": "api",
    "to": "r1"
   },
   {
    "id": "e-read2",
    "from": "api",
    "to": "r2"
   },
   {
    "id": "e-wal1",
    "from": "primary",
    "to": "r1"
   },
   {
    "id": "e-wal2",
    "from": "primary",
    "to": "r2"
   }
  ]
 },
 "metrics": [
  {
   "id": "lag",
   "label": "Replica replay lag",
   "unit": "s",
   "start": 0.03,
   "noise": 0.08,
   "normal": [
    0,
    1
   ]
  },
  {
   "id": "wal_gen",
   "label": "WAL generated (primary)",
   "unit": "MB/s",
   "start": 8,
   "noise": 0.06
  },
  {
   "id": "wal_replay",
   "label": "WAL replayed (replica)",
   "unit": "MB/s",
   "start": 8,
   "noise": 0.06
  },
  {
   "id": "stale",
   "label": "Stale read-after-write",
   "unit": "%",
   "start": 0.2,
   "noise": 0.1,
   "normal": [
    0,
    1
   ]
  },
  {
   "id": "primary_reads",
   "label": "Reads on primary",
   "unit": "qps",
   "start": 120,
   "noise": 0.05
  }
 ],
 "dashboard": [
  {
   "id": "lag",
   "title": "Replica replay lag",
   "metrics": [
    "lag"
   ],
   "threshold": {
    "value": 5,
    "label": "alert 5s"
   }
  },
  {
   "id": "wal",
   "title": "WAL: generated vs replayed",
   "metrics": [
    "wal_gen",
    "wal_replay"
   ]
  },
  {
   "id": "stale",
   "title": "Reads that miss your own write",
   "metrics": [
    "stale"
   ],
   "threshold": {
    "value": 5,
    "label": "alert 5%"
   }
  },
  {
   "id": "primary_reads",
   "title": "Reads served by primary",
   "metrics": [
    "primary_reads"
   ]
  }
 ],
 "alerts": [
  {
   "id": "lag-high",
   "metric": "lag",
   "op": ">",
   "value": 5,
   "for_s": 15,
   "severity": "critical",
   "component": "r2",
   "summary": "pg-replica replay_lag > 5s"
  },
  {
   "id": "stale-high",
   "metric": "stale",
   "op": ">",
   "value": 5,
   "for_s": 10,
   "severity": "warning",
   "component": "api",
   "summary": "profile-api stale read-after-write > 5%"
  }
 ],
