{
 "schema": "sim-xp/playbook@2",
 "meta": {
  "id": "cache-stampede-after-deploy",
  "title": "The cold cache: a deploy that forgot everything",
  "story": "A shop's product pages are served from Redis 96% of the time, and Postgres only sees the misses. A routine Thursday deploy rolls out across six web pods. Nothing in it touches the database, yet within a minute the site is returning 504s.",
  "duration_s": 420,
  "tags": [
   "redis",
   "caching",
   "cache-stampede",
   "thundering-herd",
   "postgres",
   "pgbouncer"
  ],
  "background": [
   {
    "title": "The system",
    "body": "storefront-web serves product pages at about 2,400 requests a second. Page data comes from Redis 96% of the time; only misses reach Postgres, through pgbouncer, which has just 20 real connections to the database."
   },
   {
    "title": "How it normally works",
    "body": "A miss costs one catalog query (about 40 ms), the result is written back to Redis with a 6-hour TTL, and the next request hits. The database only ever sees the misses."
   },
   {
    "title": "Today",
    "body": "A routine deploy bumps the cache key version from v41 to v42 to ship a new product badge. Nothing in it touches the database."
   }
  ],
  "cast": [
   {
    "name": "shoppers",
    "role": "about 2,400 requests a second"
   },
   {
    "name": "edge-nginx",
    "role": "routes requests to the web pods"
   },
   {
    "name": "storefront-web",
    "role": "six pods, reads through the cache"
   },
   {
    "name": "cache-redis",
    "role": "holds product pages under versioned keys"
   },
   {
    "name": "pgbouncer",
    "role": "20 server connections to the database"
   },
   {
    "name": "catalog-db",
    "role": "the source of truth"
   }
  ],
  "watch": [
   {
    "label": "Cache miss ratio",
    "normal": "normal about 4%"
   },
   {
    "label": "Clients waiting for a connection",
    "normal": "normal 0"
   },
   {
    "label": "5xx rate",
    "normal": "normal about 0%"
   }
  ],
  "learn": [
   "why a deploy that never touches the database can take it down",
   "why queries that time out never refill the cache",
   "how to warm, coalesce and shed so a cold cache does not become an outage"
  ],
  "layout": {
   "columns": 2,
   "rows": 5
  }
 },
