   }
  ],
  "learnings": [
   {
    "glyph": "🔥",
    "title": "Warm new keys before switching",
    "body": "Backfill a new cache version at a rate the DB can take, then flip the flag."
   },
   {
    "glyph": "🔒",
    "title": "Coalesce misses per key",
    "body": "A lock or singleflight per key plus serve-stale means one query per miss, not thousands."
   },
   {
    "glyph": "⏱",
    "title": "Let slow fills still land",
    "body": "If timeouts cancel the fill, an overloaded cache can never recover by itself."
   },
   {
    "glyph": "✕",
    "title": "More pods won't fix a pool cap",
    "body": "Scaling web adds clients to the same 20 DB connections; find the real bottleneck."
   }
  ],
  "math": {
   "title": "Why 20 connections cannot keep up",
   "lines": [
    "2,400 req/s, every one a miss  = 2,400 queries/s wanted",
    "20 connections / 40 ms a query     = about 500 queries/s at best",
    "2,400 / 500                       = about 5x what the pool can run",
    "and queries only get slower as they queue; past 4 s they are cancelled and never cached"
   ]
  },
  "myths": [
   {
    "myth": "Scale out the web tier.",
    "truth": "More pods send more misses to the same 20 connections. It makes the stampede bigger."
   },
   {
    "myth": "The database got slow.",
    "truth": "It was fine. It was asked for about five times the queries its 20 connections can run."
   }
  ]
