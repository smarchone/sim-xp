 "report": {
  "tldr": "Bumping the cache key version made every product page miss at once. 2,400 req/s fell onto 20 DB connections, queries timed out before they could refill the cache, and the site returned 504s until the old keys were used again.",
  "fix_t": 196,
  "chain": [
   {
    "id": "bump",
    "kind": "cause",
    "text": "Deploy bumps cache key v41 → v42"
   },
   {
    "id": "miss",
    "kind": "effect",
    "text": "Every page misses Redis at once"
   },
   {
    "id": "queue",
    "kind": "effect",
    "text": "20 DB conns, 230+ clients queued"
   },
   {
    "id": "timeout",
    "kind": "amp",
    "text": "Queries hit 4s timeout, never cached"
   },
   {
    "id": "retry",
    "kind": "amp",
    "text": "504s + retries + scale-out add load"
   },
   {
    "id": "fix",
    "kind": "fix",
    "text": "Fix: flag back to warm v41 keys"
   }
  ],
  "loop": {
   "from": "timeout",
